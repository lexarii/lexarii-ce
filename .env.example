# Lexarii configuration.
#
# THERE ARE SIXTY-SEVEN VARIABLES IN THIS FILE AND YOU NEED THREE.
#
#   DATABASE_URL            where Postgres is
#   LEXARII_LIBRARY_DIR     where your books are
#   LEXARII_DATA_DIR        where Lexarii may write
#
# Four with docker compose, which also needs POSTGRES_PASSWORD for the
# database it creates - and has no default for it on purpose.
#
# Everything else has a default that is correct for a single person running
# this on their own machine. The rest of the file is here so that the defaults
# are visible rather than buried, and so the things you might genuinely want -
# a model endpoint, single sign-on, a memory budget on a Raspberry Pi - are
# findable when you want them.
#
# Blank means "use the default". Deleting a line means the same thing. Nothing
# here needs to be set to its own default.
#
# The four groups, in the order most people need them:
#
#   1. Required           the three above, and the database password
#   2. Worth setting      the models, the first administrator, HTTPS
#   3. Tuning             worker counts, memory budgets, timeouts
#   4. Single sign-on     OIDC, LDAP, an authenticating proxy - all optional
#
# ===========================================================================
# 1. REQUIRED
# ===========================================================================

# ---- Server ----
LEXARII_ADDR=:8080
# debug, info, warn, error.
LEXARII_LOG_LEVEL=info

# ---- Paths ----
# Library directory is READ-ONLY. Lexarii never writes to your book files.
LEXARII_LIBRARY_DIR=./library
# Derived artifacts: covers, extracted text, thumbnails.
LEXARII_DATA_DIR=./data

# ---- Database ----
# The password docker-compose.yml creates its Postgres with. Required there,
# with no default, so that no two installs share one. Make one with
#
#   openssl rand -hex 24
#
# and keep to letters and digits: it goes into DATABASE_URL below, where a
# character like @ or / would need escaping. Postgres takes it when the
# database volume is FIRST created and keeps it after that - changing it here
# later does not change it there. A database created before this was required
# has the password "lexarii"; put that here, or change it in Postgres with
# ALTER ROLE lexarii PASSWORD '...'.
#
# Not needed for a Postgres of your own; set DATABASE_URL to it instead.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://lexarii:${POSTGRES_PASSWORD}@localhost:5432/lexarii?sslmode=disable

# Apply pending migrations at startup. ON by default, because the install this
# promises is one binary and a DATABASE_URL, and a second command that must be
# re-run after every upgrade is one somebody will miss at exactly the moment
# they are least equipped to debug it. Set false if you manage schema out of
# band, and run `make migrate-up` yourself.
LEXARII_AUTO_MIGRATE=true

# ===========================================================================
# 2. WORTH SETTING
# ===========================================================================

# The first administrator.
#
# Only used when the database has NO users at all. It is a bootstrap, not a
# password reset: leaving these set does not put the password back on the next
# restart, and does not undo a change made since. `make password` is the reset.
#
# Without them a fresh install offers a setup form to whoever reaches it first,
# which is right at a keyboard and wrong for a container on a network.
LEXARII_ADMIN_USERNAME=
LEXARII_ADMIN_PASSWORD=
LEXARII_ADMIN_EMAIL=

# ---- Chat model (OpenAI-compatible endpoint) ----
# Optional. The library and the reader work completely without one; only
# enrichment and chat degrade. Leave the URL blank to run without a model.
#
# llama.cpp:  ./llama-server -m model.gguf --host 0.0.0.0 --port 8080
LEXARII_LLM_BASE_URL=http://localhost:8081/v1
LEXARII_LLM_MODEL=qwen3-8b-instruct
LEXARII_LLM_API_KEY=
# The model's context window, and the one variable here you should check
# against your own server: it must match what llama.cpp was started with
# (-c / --ctx-size), because it is what decides how many retrieved passages
# fit in a question.
#
# Ten passages at this library's median chunk length is about 3,800 tokens,
# the surrounding prompt is 550, a conversation's history another 750, and
# 4,000 are reserved for the answer itself. Against 8,192 that does not fit,
# so Lexarii drops the lowest-ranked passages until it does. Setting this
# HIGHER than your server's real window does not buy room - it makes the
# server truncate the prompt instead, silently, from the front, where the
# instruction to cite its sources lives.
LEXARII_LLM_CONTEXT_TOKENS=8192
LEXARII_LLM_MAX_CONCURRENCY=2
LEXARII_LLM_TIMEOUT=120s

# Provider adjustments for the CHAT model only. Blank for llama.cpp.
#
# LEXARII_LLM_EXTRA_BODY is a JSON object merged into every chat request.
# LEXARII_LLM_EXTRA_HEADERS is a JSON object of extra request headers.
# Both are checked at startup. EXTRA_BODY refuses the fields Lexarii sets
# itself (model, messages, stream, response_format, max_tokens, temperature,
# stop, reasoning_effort, tools); EXTRA_HEADERS refuses Authorization, which can
# only come from LEXARII_LLM_API_KEY. Keep the values in single quotes.
#
# LEXARII_LLM_REASONING_EFFORT replaces the reasoning effort Lexarii asks
# for (it asks for "none" on extraction and answering, so a thinking model does
# not spend its token budget before it answers). Set "default" to stop sending
# the field at all - needed for models that cannot switch reasoning off and
# reject "none". Blank leaves Lexarii's choice alone. If EXTRA_BODY carries
# OpenRouter's own "reasoning" object, no reasoning_effort is sent, and setting
# an effort here as well is refused at startup. EXTRA_BODY keys must be ASCII.
# Extra headers are dropped if a redirect leaves the endpoint's host.
#
# Example: OpenRouter (https://openrouter.ai/docs/guides/routing/provider-selection)
#
#   LEXARII_LLM_BASE_URL=https://openrouter.ai/api/v1
#   LEXARII_LLM_MODEL=vendor/model-name
#   LEXARII_LLM_API_KEY=sk-or-...
#   LEXARII_LLM_EXTRA_BODY='{"provider":{"require_parameters":true,"data_collection":"deny"}}'
#   LEXARII_LLM_EXTRA_HEADERS='{"HTTP-Referer":"https://books.example","X-Title":"Lexarii"}'
#
# require_parameters sends a request only to providers that support every
# parameter in it, which is what makes the structured-output schema binding
# rather than a hint; the cost is that a model with no such provider fails with
# "no available providers" instead of answering loosely. data_collection "deny"
# excludes providers that may store prompts. "zdr":true is stricter (zero data
# retention endpoints only) and leaves fewer models to choose from.
#
# PRIVACY: with a hosted provider, passages from your books are sent to it, to
# the model's host, in every enrichment and every chat answer. See "Hosted chat
# providers" in docs/ARCHITECTURE.md before pointing a library at one.
# Embeddings and reranking are separate settings below and are NOT switched by
# this: changing the embedding model means re-embedding every passage.

# ---- Embedding model (often a different server) ----
# Optional, and separate because it usually IS a separate server. Without it
# retrieval falls back to keyword search, which is worse and not broken.
LEXARII_EMBED_BASE_URL=http://localhost:8082/v1
LEXARII_EMBED_MODEL=nomic-embed-text-v1.5
LEXARII_EMBED_API_KEY=
# 768, and only 768. The vector column is that wide in the schema, so this is
# a statement of fact about the database rather than a choice - use an
# embedding model with a different width and every insert fails. Lexarii now
# reads the column at startup and refuses to boot on a mismatch, rather than
# discovering it one row at a time hours into an embedding run.
LEXARII_EMBED_DIMENSIONS=768
LEXARII_EMBED_MAX_CONCURRENCY=4
LEXARII_EMBED_TIMEOUT=60s

# ===========================================================================
# 3. TUNING
# ===========================================================================

# ---- Workers ----
# How many books are ingested, enriched and embedded at once.
LEXARII_WORKER_COUNT=4
# How much of a book one enrichment sends the model. Blank uses 16,000
# characters. Almost the whole cost of enriching a book is the model reading
# this, so it is the dial for making enrichment faster or more thorough.
LEXARII_ENRICH_SAMPLE_CHARS=
# Make every new book searchable as it arrives, by upload or by scan: true
# queues chunking as each file is ingested, and embedding follows when an
# embedding model is configured. false (the default) leaves it to an
# administrator's "index" (POST /api/v1/index). Chunking is cheap; embedding a
# first scan of a large library is a lot of GPU time, which is why this is opt-in.
LEXARII_INDEX_ON_INGEST=false
# Have the model describe every new book as it arrives, by upload or by scan:
# true queues enrichment for each book an extraction leaves readable, for
# whoever added it, who can follow it. false (the default) leaves it to an
# administrator's "describe more books" (POST /api/v1/enrich). Ignored with no
# chat model configured. It is model time per book, which is why this is opt-in.
LEXARII_ENRICH_ON_INGEST=false

# ---- Uploads ----
# Lexarii's OWN managed storage for uploaded books. Deliberately separate from
# LEXARII_LIBRARY_DIR, which is read-only and never written to.
# Defaults to <LEXARII_DATA_DIR>/uploads.
LEXARII_UPLOAD_DIR=
# The largest single file an upload may be, in megabytes.
LEXARII_MAX_UPLOAD_MB=2048
# Who may upload books: "admins" (the default) or "users".
#
# With "users", anybody signed in can add books to their own shelf. A book
# someone uploads is theirs: nobody else sees it until they lend it, and two
# people who upload the same file each get it on their own shelf; the reply to
# an upload never says that somebody else already had it. The size cap above
# applies to everyone, but there is no per-person quota, so only open this to
# people you would trust with the disk. Scanning the library directory,
# enrichment and indexing stay administrator-only either way.
LEXARII_UPLOAD_POLICY=admins

# Who may list the people on this installation: all (the default) or none.
#
# A share picker offers a list of everyone with an account to lend a book to.
# In a household that list is the point; on a larger installation it is every
# member, handed to each of them. With none, only administrators can list
# accounts, and everybody else lends a book - or shares their notes - by
# typing the recipient's exact username. Naming one that does not exist is
# answered "no account by that name": lending by name cannot hide which names
# exist, so with none the list is not handed out, but somebody holding a book
# who guesses a username can still learn that it is one - only with a book
# of their own to lend (or notes on one to share), and only a few wrong
# guesses at a time: after 8 names that match nobody in 15 minutes they are
# refused for 15 minutes.
LEXARII_PEOPLE_DIRECTORY=all

# What happens to the books only a deleted account held: archive (the default)
# or erase.
#
# archive keeps them, marked with the leaver's name, for an administrator to
# hand on; an upload is moved into the archive, and the record expires after
# LEXARII_ARCHIVE_RETENTION while the file is kept. erase deletes them as the
# account goes: the record, its passages, cover and access log, everybody's
# notes on it, and then the copies Lexarii stored in its upload directory or
# archive - straight away, or, if the disk refuses or somebody's upload of the
# same bytes is still waiting, at every start and every hour until done. An
# archive record that expires takes its stored copy with it too; that covers
# the few books erasing keeps for a while (one another person's upload is
# waiting for, or the leaver's own upload already being extracted). Nothing in
# LEXARII_LIBRARY_DIR is ever deleted - it is read-only; such a book's record
# goes and a later scan finds the file again. Either way, a book somebody else
# also holds simply loses a holder. Administrators can also erase one person's
# books on demand: POST /api/v1/admin/users/{id}/erase-files.
LEXARII_DELETED_ACCOUNT_FILES=archive

# ---- Retrieval ----
# A cross-encoder that reorders retrieved passages before they are read.
#
# Unset means no reranking, which is the default. This is its own endpoint
# because a cross-encoder is a different KIND of model from the one that writes
# answers: it reads a question and one passage together and scores the pair.
# Measured on a real 173-book library with bge-reranker-v2-m3: work MRR 0.748
# -> 0.806, passage Recall@10 0.625 -> 0.688, passage MRR 0.434 -> 0.514, for
# about half a second a question on a 12GB RTX 3060 that is already serving the
# chat and embedding models. The quality figures are properties of the models;
# the half second is one consumer card doing three jobs, and will differ on
# yours. Asking the CHAT model to do the same job made
# retrieval worse instead - 0.892 -> 0.811 Recall@10 at four times the latency
# - so that path was removed rather than left as an option.
#
# llama.cpp serves one:
#
#   llama-server -hf gpustack/bge-reranker-v2-m3-GGUF:Q8_0 \
#     --port 8082 --embedding --pooling rank --reranking
#
# bge-reranker-v2-m3 is about 600MB at Q8_0. Beware community GGUF conversions
# that were made without the model's classification head: they load, serve, and
# return a score like 1e-28 for every passage. Lexarii refuses scores that
# cannot order anything rather than ranking by noise, and says so in the log -
# if you see that, the conversion is the problem, not the model.
#
# After pointing this at one, re-run `make eval` and compare. The numbers above
# are what it has to beat.
# Hosted rerankers work too - the request shape is Jina's and Cohere's:
#
#   Jina    https://api.jina.ai/v1
#   Cohere  https://api.cohere.com/v2
#   Voyage  https://api.voyageai.com/v1
#
# Groq, OpenAI and Anthropic do NOT offer reranking - there is no rerank
# endpoint on any of them. Using one of them as your CHAT model is fine and
# unrelated; this is a separate endpoint and can be left unset.
#
# There is a systemd unit in deploy/systemd/llama-reranker.service, named to
# sit alongside the chat and embedding servers on a machine that serves models.
LEXARII_RERANK_BASE_URL=
LEXARII_RERANK_MODEL=
LEXARII_RERANK_API_KEY=
LEXARII_RERANK_TIMEOUT=30s

# ---- Deleted accounts ----
# When an account is deleted the person goes immediately - notes, reading
# positions, conversations - and the books they owned are archived against their
# name so an administrator can hand them on, or so they are still there if the
# person comes back.
#
# This is how long an unclaimed archive RECORD is kept before it is deleted. The
# FILES are kept regardless: the retention is about holding a row that names
# somebody who left, not about throwing books away. Six months by default; set
# it to match your own data protection policy. A duration, such as 720h.
LEXARII_ARCHIVE_RETENTION=

# How long a finished job (an import, an extraction, an enrichment) is kept
# before it is deleted. An upload's job names the file that was uploaded, so the
# queue would otherwise be a permanent record of what everybody added; when an
# account is deleted, or an administrator erases somebody's books, their
# finished jobs lose those names at once anyway. 30 days by default; at least
# 168h, since enrichment reads a week of finished jobs back. A duration, such
# as 720h.
LEXARII_JOB_RETENTION=

# ---- Authentication ----
# Session cookies are marked Secure by default, so browsers send them only over
# HTTPS. Set to false ONLY for plain HTTP on a trusted network.
LEXARII_SECURE_COOKIES=true
# Your own links under the sign-in form - how to ask for an account, where to
# get a password reset, the house rules. A JSON array of {"label","href"}, at
# most 8, labels up to 60 characters. An href is a path on this server
# beginning with "/" or an https:// URL; anything else stops startup. Blank
# shows none. Example:
#   [{"label":"Request access","href":"https://example.org/library-access"},
#    {"label":"Forgot password?","href":"/help/password"}]
LEXARII_SIGNIN_LINKS=
# Your own look for the sign-in page: a directory holding a branding.css and
# the images and fonts it uses, served read-only at /branding/ to anyone and
# loaded after the app's own styles. Only css, svg, png, webp, avif, woff2 and
# ico, up to 4 MiB each. Must exist and be a directory, or startup stops.
# Blank, the default, serves nothing. See docs/BRANDING.md for the hooks and
# tokens it can use, and docs/branding-example/ for a start.
LEXARII_BRANDING_DIR=

# ===========================================================================
# 4. SINGLE SIGN-ON - all optional, all off, skip unless you want one
#
# Local passwords keep working alongside every one of these, deliberately: an
# issuer that is unreachable or misconfigured must not lock you out of your
# own library. Each provider has one variable that switches it on, and the
# rest do nothing until that one is set.
# ===========================================================================

# ---- OpenID Connect (optional) ----
# Local passwords keep working alongside this, so a misconfigured issuer cannot
# lock you out. Leave the issuer blank to disable.
LEXARII_OIDC_ISSUER=
LEXARII_OIDC_CLIENT_ID=
LEXARII_OIDC_CLIENT_SECRET=
LEXARII_OIDC_LABEL="Single sign-on"
LEXARII_OIDC_SCOPES=openid,profile,email
# Create an account the first time someone signs in. OFF by default: against a
# public issuer this would let anyone with an account there into your library.
LEXARII_OIDC_ALLOW_SIGNUP=false

# ---- LDAP / Active Directory (optional) ----
# Leave the URL blank to disable. Local passwords keep working alongside this.
LEXARII_LDAP_URL=
# The name on the sign-in button. Defaults to "Directory", or to "Active
# Directory" when LEXARII_LDAP_ACTIVE_DIRECTORY=true.
LEXARII_LDAP_LABEL=
# Upgrade a plain ldap:// connection to TLS before any password is sent. ON by
# default, skipped for ldaps:// which is already encrypted. Turning this off
# sends passwords across the network in the clear.
LEXARII_LDAP_STARTTLS=true
# Accept a certificate without verifying it. This removes the protection TLS
# was there to provide and is logged loudly every time it is used. It exists
# because internal directories routinely use a private CA; installing that CA
# on this machine is the better answer.
LEXARII_LDAP_INSECURE_SKIP_VERIFY=false
LEXARII_LDAP_BASE_DN=
# A service account used to FIND the user; Lexarii then binds as the user
# themselves to authenticate. Leave blank for anonymous search.
LEXARII_LDAP_BIND_DN=
LEXARII_LDAP_BIND_PASSWORD=
# Defaults to (uid=%s), or AD's sAMAccountName/userPrincipalName when
# LEXARII_LDAP_ACTIVE_DIRECTORY=true.
LEXARII_LDAP_USER_FILTER=
# An alternative to searching: build the user's DN directly from what they
# typed, e.g. uid=%s,ou=people,dc=example,dc=com. Needs no service account and
# no base DN, and only works where every user sits in one flat container.
LEXARII_LDAP_USER_DN_TEMPLATE=
# Set true for Active Directory: it switches the attribute names, which differ
# from OpenLDAP in every one that matters.
LEXARII_LDAP_ACTIVE_DIRECTORY=false
# Restrict access to one group when the directory serves more people than
# should have a library.
LEXARII_LDAP_REQUIRED_GROUP=
LEXARII_LDAP_ALLOW_SIGNUP=false

# ---- Reverse-proxy SSO (optional) ----
# For an authenticating proxy already in front of Lexarii: oauth2-proxy,
# Authelia, Authentik, a corporate gateway. Leave the header blank to disable.
LEXARII_PROXY_USER_HEADER=
# The name shown on the sign-in page. Defaults to "Single sign-on".
LEXARII_PROXY_LABEL=
# These three already default to what oauth2-proxy, Authelia and Authentik all
# send, so they are shown rather than needed. Set them if your proxy differs.
LEXARII_PROXY_EMAIL_HEADER=X-Forwarded-Email
LEXARII_PROXY_NAME_HEADER=X-Forwarded-Preferred-Username
LEXARII_PROXY_GROUPS_HEADER=X-Forwarded-Groups
# The addresses or CIDR blocks of your own reverse proxies.
#
# REQUIRED when LEXARII_PROXY_USER_HEADER is set: a header is only a
# credential because of where it came from, and without this anyone who can
# reach this server can claim to be anyone.
#
# WORTH SETTING EVEN IF YOU DO NOT USE PROXY SSO. It is also what lets the
# sign-in rate limit tell your readers apart. Behind nginx or Caddy every
# request arrives from the proxy, so without this the whole household shares
# one bucket and eight wrong passwords from anybody locks sign-in for
# everyone. With it, X-Forwarded-For is read - from the right, past your own
# hops, so a client cannot forge its way into somebody else's bucket - and a
# failed attempt is counted against whoever actually made it.
#
# Set it to where the proxy connects FROM, which for a proxy on the same host
# is both loopback addresses: 127.0.0.1 alone silently misses a proxy that
# connects over IPv6, and everything then shares ::1 again.
#
#   LEXARII_PROXY_TRUSTED=127.0.0.1,::1
#
# Leave it blank only when nothing sits in front of Lexarii, in which case
# the socket address is already the reader's own.
LEXARII_PROXY_TRUSTED=
LEXARII_PROXY_REQUIRED_GROUP=
LEXARII_PROXY_ALLOW_SIGNUP=true

# ---- External metadata catalogue (optional, OFF by default) ----
# The only part of Lexarii that talks to anything outside your machine.
# `make metadata ARGS=-apply` sends a title and an author, or an ISBN, to this
# address - one request per book - to fill in publishers, years and ISBNs that
# your files did not carry. A description of your shelf leaving your network is
# exactly the thing this project otherwise promises not to do, so it is blank
# by default and nothing happens until you set it.
#
# https://openlibrary.org is the obvious choice: CC0 data, no API key. It can
# also be self-hosted, which is why this is a URL rather than a switch.
LEXARII_METADATA_BASE_URL=
LEXARII_METADATA_USER_AGENT=
LEXARII_METADATA_TIMEOUT=10s

# ---- How this installation is reached from outside (optional) ----
# Used where a link has to survive leaving the application - so far, the url
# field of an exported citation. Left out rather than guessed: a bibliography
# carrying http://localhost:8080 names the reader's own machine.
LEXARII_PUBLIC_URL=

# ---- Reader memory (optional) ----
# How much memory the reader's parsed PDFs may hold, in MB. Default 512.
#
# Megabytes rather than a number of books, because books are not comparable:
# in a real library one parses to 76MB and another to 176MB, so "four books"
# means either 300MB or 700MB depending which four somebody opens.
#
# Resident memory runs about 1.45x this, because Go's collector keeps headroom.
# Measured by opening the fourteen largest books in a 168-book library one
# after another:
#
#   512 (default)  about 750MB resident; two large books or six ordinary ones
#   256            168-393MB resident across all fourteen
#   128            one book at a time; the setting for a Raspberry Pi
#
# The cost of a tighter budget is a re-parse when an evicted book is opened
# again - about a third of a second.
LEXARII_PDF_CACHE_MB=
