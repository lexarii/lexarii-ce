# Build output
/bin/
/dist/
# Root-anchored, and this matters: a bare `lexarii` matches EVERY path
# component with that name, which silently excluded cmd/lexarii - the whole
# server command - from the repository. A fresh clone had no main package and
# could not be built, and `go build ./...` did not complain because there was
# nothing there to compile.
/lexarii

# Embedded client build (generated by `make build`).
# The placeholder index.html IS tracked: go:embed fails outright on an empty
# directory, so without it a fresh clone would not compile at all.
/internal/http/static/*
!/internal/http/static/index.html

# Node
node_modules/
web/.svelte-kit/
web/build/
web/.vite/
# npm run test:coverage
web/coverage/

# Env & local config
.env
.env.local
*.local

# Data directories
/data/
/library/

# Test artifacts
coverage.out
*.test

# Editors / OS
.DS_Store
*.swp
.idea/

# Browser-testing artefacts.
.playwright-mcp/

# Session tokens written by hand while testing a share or a grantee's view.
# Inert once the session is deleted, but never worth committing.
*-token

# Screenshots taken while checking a screen in a browser. Playwright writes to
# the repository root when given a bare filename.
/ui-*.png

# Android build output and machine-local SDK path.
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Optional developer signing for the release build type (android/app/build.gradle.kts).
# F-Droid signs what it builds and never needs this; it exists only so Adam can
# sign a release himself to check it against F-Droid's reproducible build.
android/keystore.properties
android/*.jks
android/*.keystore

# Binaries from `go build ./scripts/<name>` run at the repository root.
/apikotlin
/apispec
/authors
/bylines
/classifyeval
/eval
/metadata
/password
/tags
/titles
/watch
