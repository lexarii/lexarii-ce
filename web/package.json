{
  "name": "lexarii-web",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:android-reader": "node --test-reporter=spec tests/android-reader/reader.test.mjs",
    "test:coverage": "vitest run --coverage && READER_TEST_COVERAGE=coverage/lcov.info npm run --silent test:android-reader",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "playwright-core": "1.63.0",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pdfjs-dist": "^5.6.205"
  }
}
